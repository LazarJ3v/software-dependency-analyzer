# Primer .env fajla za frontend. Kopiraj ga u ".env" (npm: cp .env.example .env).
# Vite u browser izlaze samo promenljive sa prefiksom VITE_, zato ovde
# NIKADA ne stavljaj lozinke ili Neo4j podatke - njih zna samo backend.

# false = prikazuju se mock podaci (backend i baza nisu potrebni)
# true  = prikazuju se pravi podaci iz Neo4j baze preko backend API-ja
VITE_USE_REAL_DATA=false

# Adresa backend API-ja (vidi sda/Properties/launchSettings.json)
VITE_API_URL=http://localhost:5027
