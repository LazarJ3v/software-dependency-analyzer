# Primer .env fajla. Kopiraj ovaj fajl u ".env" i popuni pravim vrednostima.
# Fajl ".env" se NE commit-uje (vidi .gitignore).

# --- Neo4j Aura ---
# Connection URI iz Aura konzole (format: neo4j+s://<instance-id>.databases.neo4j.io)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# Za Aura instance korisnicko ime je obicno isto kao ID instance
NEO4J_USERNAME=<instance-id>
# Lozinka koja je prikazana samo jednom pri kreiranju instance
NEO4J_PASSWORD="<aura-password>"
# Za Aura instance ime baze je obicno isto kao ID instance
NEO4J_DATABASE=<instance-id>

# Metapodaci Aura instance
AURA_INSTANCEID=<instance-id>
AURA_INSTANCENAME=<instance-name>
